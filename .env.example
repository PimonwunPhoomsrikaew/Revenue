# Web server
PORT=3000
SESSION_SECRET=change-me

# ---------------------------------------------------------------------------
# JHCIS branches. Each branch is one web-app login (BRANCH_<code>_APP_USER /
# _APP_PASS) mapped to its own JHCIS MySQL database. Whichever user logs in,
# the app connects only to that branch's database for the rest of the
# session. List every branch's code in BRANCH_CODES, then add one block of
# BRANCH_<code>_* vars per code.
# ---------------------------------------------------------------------------
BRANCH_CODES=01088

# Branch: 01088
BRANCH_01088_NAME=01088
BRANCH_01088_APP_USER=
BRANCH_01088_APP_PASS=
BRANCH_01088_DB_HOST=
BRANCH_01088_DB_PORT=3306
BRANCH_01088_DB_USER=
BRANCH_01088_DB_PASSWORD=
BRANCH_01088_DB_NAME=
